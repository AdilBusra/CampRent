<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" lang="en">
<head>
    <meta charset="UTF-8">
    <title>Booking Success - CampRent</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#F4F4F2] text-slate-800 font-sans antialiased">

<div th:replace="~{fragments/customer-navbar :: customerNavbar('booking')}"></div>

<main class="pt-24 min-h-screen flex items-center justify-center px-8">

    <section class="w-full max-w-2xl bg-white rounded-3xl border border-gray-100 shadow-sm p-10 text-center">

        <div class="mx-auto w-20 h-20 rounded-full bg-green-100 flex items-center justify-center text-4xl">
            ✅
        </div>

        <h1 class="mt-6 text-3xl font-bold text-[#19381C]">
            Booking Submitted!
        </h1>

        <p class="mt-3 text-gray-500">
            Your equipment booking has been created successfully.
        </p>

        <div class="mt-8 rounded-2xl bg-[#F4F4F2] p-5 text-left space-y-4">

            <div class="flex justify-between">
                <span class="text-gray-500">Booking ID</span>
                <span class="font-bold text-[#19381C]">#BK001</span>
            </div>

            <div class="flex justify-between">
                <span class="text-gray-500">Store</span>
                <span class="font-bold text-[#19381C]">Mountain Adventure</span>
            </div>

            <div class="flex justify-between">
                <span class="text-gray-500">Status</span>
                <span class="rounded-full bg-yellow-100 px-3 py-1 text-xs font-bold text-yellow-700">
                    PENDING
                </span>
            </div>

        </div>

        <div class="mt-6 rounded-xl border border-yellow-300 bg-yellow-50 p-4 text-left">
            <p class="text-sm text-yellow-800">
                ⚠ Please pick up your equipment within 2 hours after booking confirmation.
                If it is not picked up, the booking may be cancelled automatically.
            </p>
        </div>

        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">

            <a th:href="@{/customer/my-booking}"
               class="rounded-xl bg-[#E27252] px-6 py-3 text-white font-semibold hover:bg-[#c85f41]">
                View My Booking
            </a>

            <a th:href="@{/customer/katalog}"
               class="rounded-xl border border-gray-200 px-6 py-3 font-semibold hover:bg-[#F4F4F2]">
                Back to Catalog
            </a>

        </div>

    </section>

</main>

</body>
</html>