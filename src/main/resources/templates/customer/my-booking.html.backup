<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Booking - CampRent</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#F4F4F2] text-slate-800 font-sans antialiased">

<div th:replace="~{fragments/customer-navbar :: customerNavbar('booking')}"></div>

<main class="pt-24 min-h-screen">

  <section class="max-w-7xl mx-auto px-8 pb-16">

    <section class="mb-8">
      <h1 class="text-3xl font-bold text-[#19381C]">My Booking</h1>
      <p class="text-sm text-gray-500 mt-1">
        Monitor your equipment bookings, pickup status, and return date.
      </p>
    </section>

    <section class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">

      <div class="overflow-x-auto">

        <table class="w-full text-left">

          <thead class="bg-[#19381C] text-white">
          <tr>
            <th class="px-5 py-4 text-sm font-semibold">Booking ID</th>
            <th class="px-5 py-4 text-sm font-semibold">Store</th>
            <th class="px-5 py-4 text-sm font-semibold">Rent Date</th>
            <th class="px-5 py-4 text-sm font-semibold">Return Date</th>
            <th class="px-5 py-4 text-sm font-semibold">Total Price</th>
            <th class="px-5 py-4 text-sm font-semibold">Status</th>
            <th class="px-5 py-4 text-sm font-semibold">Detail</th>
          </tr>
          </thead>

          <tbody class="divide-y divide-gray-100">

          <!-- Empty state nanti dipakai backend -->
          <tr th:if="${listBooking != null and #lists.isEmpty(listBooking)}">
            <td colspan="7" class="px-5 py-16">
              <div class="flex flex-col items-center justify-center text-center">
                <div class="text-6xl mb-4">📋</div>

                <h3 class="text-xl font-bold text-[#19381C]">
                  No Bookings Yet
                </h3>

                <p class="mt-2 text-sm text-gray-500 max-w-md">
                  Your booking history will appear here after you reserve equipment.
                </p>
              </div>
            </td>
          </tr>

          <!-- Dummy row FE preview -->
          <tr onclick="openCustomerBookingDetailModal()"
              class="hover:bg-[#F4F4F2] transition cursor-pointer">

            <td class="px-5 py-4 font-semibold">
              #BK001
            </td>

            <td class="px-5 py-4">
              <p class="font-semibold">Mountain Adventure</p>
              <p class="text-xs text-gray-500">Medan</p>
            </td>

            <td class="px-5 py-4">
              2026-05-29
            </td>

            <td class="px-5 py-4">
              2026-06-01
            </td>

            <td class="px-5 py-4 font-semibold">
              Rp250.000
            </td>

            <td class="px-5 py-4">
                            <span class="rounded-full bg-yellow-100 px-3 py-1 text-xs font-semibold text-yellow-700">
                                PENDING
                            </span>
            </td>

            <td class="px-5 py-4">
              <button type="button"
                      onclick="event.stopPropagation(); openCustomerBookingDetailModal();"
                      class="rounded-lg bg-[#E27252] px-3 py-2 text-sm font-semibold text-white hover:bg-[#c85f41]">
                View Detail
              </button>
            </td>

          </tr>

          <tr onclick="openCustomerBookingDetailModal()"
              class="hover:bg-[#F4F4F2] transition cursor-pointer">

            <td class="px-5 py-4 font-semibold">
              #BK002
            </td>

            <td class="px-5 py-4">
              <p class="font-semibold">Outdoor Medan</p>
              <p class="text-xs text-gray-500">Medan</p>
            </td>

            <td class="px-5 py-4">
              2026-05-25
            </td>

            <td class="px-5 py-4">
              2026-05-27
            </td>

            <td class="px-5 py-4 font-semibold">
              Rp150.000
            </td>

            <td class="px-5 py-4">
                            <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700">
                                DIPAKAI
                            </span>
            </td>

            <td class="px-5 py-4">
              <button type="button"
                      onclick="event.stopPropagation(); openCustomerBookingDetailModal();"
                      class="rounded-lg bg-[#E27252] px-3 py-2 text-sm font-semibold text-white hover:bg-[#c85f41]">
                View Detail
              </button>
            </td>

          </tr>

          </tbody>

        </table>

      </div>

    </section>

  </section>

</main>

<!-- Booking Detail Modal -->
<div id="customerBookingDetailModal"
     class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4">

  <div class="w-full max-w-2xl max-h-[85vh] overflow-y-auto rounded-2xl bg-white shadow-xl">

    <div class="flex items-center justify-between bg-[#19381C] px-6 py-5 text-white">
      <div>
        <h2 class="text-2xl font-bold">Booking Detail</h2>
        <p class="text-sm text-white/70">Your rental reservation information</p>
      </div>

      <button type="button"
              onclick="closeCustomerBookingDetailModal()"
              class="text-3xl leading-none hover:text-[#E27252]">
        ×
      </button>
    </div>

    <div class="p-6 space-y-6">

      <section class="grid grid-cols-1 md:grid-cols-2 gap-4">

        <div class="rounded-xl bg-[#F4F4F2] p-4">
          <p class="text-sm text-gray-500">Booking ID</p>
          <p class="font-bold text-lg">#BK001</p>
        </div>

        <div class="rounded-xl bg-[#F4F4F2] p-4">
          <p class="text-sm text-gray-500">Status</p>
          <span class="mt-1 inline-block rounded-full bg-yellow-100 px-3 py-1 text-xs font-semibold text-yellow-700">
                        PENDING
                    </span>
        </div>

        <div class="rounded-xl bg-[#F4F4F2] p-4">
          <p class="text-sm text-gray-500">Store</p>
          <p class="font-bold">Mountain Adventure</p>
          <p class="text-sm text-gray-500">Medan</p>
        </div>

        <div class="rounded-xl bg-[#F4F4F2] p-4">
          <p class="text-sm text-gray-500">Pickup Deadline</p>
          <p class="font-bold text-red-600">
            2 hours after booking confirmation
          </p>
        </div>

        <div class="rounded-xl bg-[#F4F4F2] p-4">
          <p class="text-sm text-gray-500">Rent Date</p>
          <p class="font-bold">2026-05-29</p>
        </div>

        <div class="rounded-xl bg-[#F4F4F2] p-4">
          <p class="text-sm text-gray-500">Return Date</p>
          <p class="font-bold">2026-06-01</p>
        </div>

      </section>

      <section class="rounded-2xl border border-gray-100 overflow-hidden">
        <div class="bg-[#F4F4F2] px-5 py-4">
          <h3 class="font-bold text-[#19381C]">Booked Items</h3>
        </div>

        <div class="divide-y divide-gray-100">

          <div class="flex items-center justify-between px-5 py-4">
            <div>
              <p class="font-semibold">Tent Dome Borneo 4</p>
              <p class="text-sm text-gray-500">Qty 1 × Rp80.000/day</p>
            </div>
            <p class="font-semibold">Rp80.000</p>
          </div>

          <div class="flex items-center justify-between px-5 py-4">
            <div>
              <p class="font-semibold">Carrier Eiger 60L</p>
              <p class="text-sm text-gray-500">Qty 1 × Rp70.000/day</p>
            </div>
            <p class="font-semibold">Rp70.000</p>
          </div>

        </div>

        <div class="flex items-center justify-between bg-[#F4F4F2] px-5 py-4">
          <p class="font-bold">Total Booking</p>
          <p class="text-xl font-bold text-[#E27252]">Rp250.000</p>
        </div>
      </section>

      <section class="rounded-xl border border-yellow-300 bg-yellow-50 p-4">
        <p class="text-sm text-yellow-800">
          ⚠ Please pick up your equipment within 2 hours after booking confirmation.
          Payment is not processed inside CampRent.
        </p>
      </section>

      <div class="flex justify-end">
        <button type="button"
                onclick="closeCustomerBookingDetailModal()"
                class="rounded-xl border border-gray-200 px-5 py-3 font-semibold hover:bg-[#F4F4F2]">
          Close
        </button>
      </div>

    </div>

  </div>

</div>

<script>
  function openCustomerBookingDetailModal() {
      const modal = document.getElementById("customerBookingDetailModal");
      modal.classList.remove("hidden");
      modal.classList.add("flex");
  }

  function closeCustomerBookingDetailModal() {
      const modal = document.getElementById("customerBookingDetailModal");
      modal.classList.add("hidden");
      modal.classList.remove("flex");
  }
</script>

</body>
</html>